{
  "name": "wascell-website",
  "version": "1.0.0",
  "description": "WASCELL生命焕新之旅官方网站",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "periods:update": "node scripts/update-period-window.js",
    "periods:dry-run": "node scripts/update-period-window.js --dry-run",
    "pm2:start": "pm2 start app.js --name wascell-website",
    "pm2:stop": "pm2 stop wascell-website",
    "pm2:restart": "pm2 restart wascell-website"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "helmet": "^7.1.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  },
  "keywords": [
    "wascell",
    "medical",
    "tourism",
    "japan"
  ],
  "author": "WASCELL",
  "license": "MIT"
}
